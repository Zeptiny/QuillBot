BOT_TOKEN=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Optional overrides (defaults shown):
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# RERANK_MODEL=cohere/rerank-4-fast
# CHAT_MODEL=google/gemini-2.5-flash-lite
# VECTOR_STORE_PATH=data/vectors.json
