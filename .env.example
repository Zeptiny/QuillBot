BOT_TOKEN=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# --- LLM (any OpenAI-compatible endpoint) ---
# OPENAI_BASE_URL defaults to https://openrouter.ai/api/v1 ; set to http://localhost:11434/v1 for Ollama, etc.
# OPENAI_API_KEY can be used instead of OPENROUTER_API_KEY; both are aliases.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL / OPENROUTER_BASE_URL are also accepted as aliases.
# CHAT_MODEL and SPARK_MODEL must match the provider's model IDs.
# EMBEDDING / RERANK ---
# EMBEDDING_PROVIDER: openai (default) or local
# For local: sentence-transformers model loaded on CPU by default.
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LOCAL_EMBEDDING_DEVICE=cpu  # or cuda, mps
# RERANK_ENABLED=true  # only used when OPENAI_BASE_URL is openrouter.ai
# Optional overrides (defaults shown):
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# RERANK_MODEL=cohere/rerank-4-fast
# CHAT_MODEL=qwen/qwen3.6-plus
# SPARK_MODEL=google/gemini-2.5-pro
# VECTOR_STORE_PATH=data/vectors.json
# REINDEX_INTERVAL_HOURS=6
# WEB_SEARCH_ENABLED=true
#   Set to false to disable web search entirely.
# COOLDOWN_RATE=1
# COOLDOWN_PER=30
# LOG_LEVEL=INFO
# --- API request logging (data/api_requests.log, JSON lines) ---
# API_REQUEST_LOG_ENABLED=true  # logs every outbound HTTP request + inbound Discord interaction
# API_REQUEST_LOG_PATH=data/api_requests.log
# API_REQUEST_LOG_MAX_BYTES=10485760  # rotate after 10 MB
# API_REQUEST_LOG_BACKUPS=5
# API_REQUEST_LOG_DISCORD=true  # false omits outbound Discord REST traffic (inbound interactions still logged)
# API_REQUEST_LOG_CONSOLE=false  # also mirror to stdout / docker logs
# API_REQUEST_LOG_BODY=openai,tavily  # services with logged request/response bodies ('all'/'none')
# API_REQUEST_LOG_BODY_MAX_CHARS=20000  # per-body truncation limit
# CHAT_MENTION_ENABLED=true  # allow @bot mention to trigger chat mode (same as /chat)
# CHANNEL_CONTEXT_MESSAGES=10  # recent channel msgs auto-injected as context into /ask, /chat and @mention (0 disables)
# CONVERSATIONS_GAP_MESSAGES=20
# --- Vision images (download once, re-encode, inline as base64 data URIs) ---
# IMAGE_MAX_SIDE=640  # max dimension (px) of re-encoded JPEGs
# IMAGE_JPEG_QUALITY=80
# IMAGES_DIR=data/images
# IMAGE_RETENTION_SECONDS=86400  # stored images swept after this
# CONVERSATIONS_IMAGE_TURNS=3  # inline images only for the most recent N history turns
# --- History RAG (entire server) ---
# HISTORY_ENABLED=true
# HISTORY_VECTOR_STORE_DIR=data/history
# HISTORY_WINDOW_SIZE=5  # local context window (prev msgs per chunk)
# HISTORY_BACKFILL_LIMIT=  # empty = no limit, or e.g. 2000 per channel
# HISTORY_MAX_MSG_LENGTH=800
# HISTORY_EXCLUDE_BOTS=true
